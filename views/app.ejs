<%- include('partials/header', { title: 'Mortgage Calculator', activeTab: 'input' }) %>

<div class="container">
    <!-- Control buttons -->
    <!-- <div class="btn-group mt-3 mb-3">
        <button type="button" id="populateTestData" class="btn btn-secondary">Add Test Data</button>
        <button type="button" id="clearForm" class="btn btn-outline-secondary">Clear Form</button>
    </div> -->

    <!-- Tab Navigation -->
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="input-tab" data-bs-toggle="tab" data-bs-target="#input" type="button" role="tab" aria-controls="input" aria-selected="true">Input</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="ifw-tab" data-bs-toggle="tab" data-bs-target="#ifw_form" type="button" role="tab" aria-controls="ifw_form" aria-selected="false">IFW</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="refi_checker-tab" data-bs-toggle="tab" data-bs-target="#refi_checker" type="button" role="tab" aria-controls="refi_checker" aria-selected="false">REFI Checker</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="payoff-tab" data-bs-toggle="tab" data-bs-target="#payoff" type="button" role="tab" aria-controls="payoff" aria-selected="false">Payoff</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="escrow-tab" data-bs-toggle="tab" data-bs-target="#escrow" type="button" role="tab" aria-controls="escrow" aria-selected="false">Escrow</button>
        </li>
    </ul>

    <!-- Tab Content Container -->
    <div class="tab-content">
            <!-- Input Tab Content -->
            <div class="tab-pane fade show active" id="input">
                <form id="mortgageForm" action="/submit" method="POST">
                    <div class="card mb-4">
                        <div class="card-body">
                            <!-- Left and Right Tables -->
                            <div class="form-container">
                                <!-- Left Table -->
                                <div class="left-form">
                                    <table class="table table-bordered">
                                        <tr>
                                            <td><label class="lbl-left" for="borrowerName">Borrower Name</label></td>
                                            <td><input type="text" class="form-control" id="borrowerName" name="borrowerName" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="mortgageBalance">Current 1st Mortgage Balance</label></td>
                                            <td><input type="text" class="form-control currency-input" id="mortgageBalance" name="mortgageBalance" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="mortgageRate">Current 1st Mortgage Rate (%)</label></td>
                                            <td>
                                                <input type="text" class="form-control percentage-input" id="mortgageRate" 
                                                       name="mortgageRate" required style="text-align: right;">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="currentPITIFirst">Current P I T I 1st Mtg. </label></td>
                                            <td><input type="text" class="form-control currency-input" id="currentPITIFirst" name="currentPITIFirst" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="currentPandIorIOFirst">Current P & I or IO Pymt 1st Mtg</label></td>
                                            <td><input type="text" class="form-control currency-input" id="currentPandIorIOFirst" name="currentPandIorIOFirst" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="currentMonthlyMI">Current Monthy Mortgage Ins (MI)</label></td>
                                            <td><input type="text" class="form-control currency-input" id="currentMonthlyMI" name="currentMonthlyMI" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="currentAnnualTaxes">Current Annual Taxes</label></td>
                                            <td><input type="text" class="form-control currency-input" id="currentAnnualTaxes" name="currentAnnualTaxes" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="currentAnnualInsurance">Current Annual Insurance</label></td>
                                            <td><input type="text" class="form-control currency-input" id="currentAnnualInsurance" name="currentAnnualInsurance" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="currentInsPolEffDate">Current Ins Policy Eff. Date</label></td>
                                            <td><input type="text" class="form-control currency-input" id="currentInsPolEffDate" name="currentInsPolEffDate" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="current2ndMtgBal">Current 2nd Mtg Bal</label></td>
                                            <td><input type="text" class="form-control currency-input" id="current2ndMtgBal" name="current2ndMtgBal" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="current2ndMtgRate">Current 2nd Mtg Rate</label></td>
                                            <td><input type="text" class="form-control currency-input" id="current2ndMtgRate" name="current2ndMtgRate" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="currentPandIorIOSecond">Current P & I or IO Pymt 2nd</label></td>
                                            <td><input type="text" class="form-control currency-input" id="currentPandIorIOSecond" name="currentPandIorIOSecond" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="totalPITIFirstSecond">Total PITI 1st & 2nd</label></td>
                                            <td><input type="text" class="form-control currency-input" id="totalPITIFirstSecond" name="totalPITIFirstSecond" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="totalPIMI12Other">Total P&I & MI on 1st & 2nd & Other Debt</label></td>
                                            <td><input type="text" class="form-control currency-input" id="totalPIMI12Other" name="totalPIMI12Other" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="balOfOtherDebts">Bal of "Other" Debts to Payoff</label></td>
                                            <td><input type="text" class="form-control currency-input" id="balOfOtherDebts" name="balOfOtherDebts" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="monthlyPmtOtherDebt">Mo. Pymt of "Other" Debt to payoff</label></td>
                                            <td><input type="text" class="form-control currency-input" id="monthlyPmtOtherDebt" name="monthlyPmtOtherDebt" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="lastPaymentDate">Last Payment Date</label></td>
                                            <td><input type="date" class="form-control" id="lastPaymentDate" name="lastPaymentDate" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="estClosingDate">Est. Closing Date</label></td>
                                            <td><input type="date" class="form-control" id="estClosingDate" name="estClosingDate" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="fundingDate">Funding Date</label></td>
                                            <td><input type="date" class="form-control" id="fundingDate" name="fundingDate" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="monthEnd">Month end</label></td>
                                            <td><input type="date" class="form-control" id="monthEnd" name="monthEnd" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="noPaymentDueMonth">No Payment Due Month</label></td>
                                            <td><input type="date" class="form-control" id="noPaymentDueMonth" name="noPaymentDueMonth" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="firstPmtDueDate">1st Payment due date</label></td>
                                            <td><input type="date" class="form-control" id="firstPmtDueDate" name="firstPmtDueDate" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="estEscrowRefund">Est Escrow Refund (be conservative)</label></td>
                                            <td><input type="text" class="form-control currency-input" id="estEscrowRefund" name="estEscrowRefund" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="appraisedValue">Appraised Value</label></td>
                                            <td><input type="text" class="form-control currency-input" id="appraisedValue" name="appraisedValue" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="ficoScore">FICO Score</label></td>
                                            <td><input type="number" class="form-control" id="ficoScore" name="ficoScore" required></td>
                                        </tr>
                                        <tr>
                                            <td><label class="lbl-left" for="newInterestRate">New Interest Rate (%)</label></td>
                                            <td><input type="number" class="form-control" id="newInterestRate" name="newInterestRate" step="0.0001" min="0" max="100" required></td>
                                        </tr>
                                    </table>
                                </div>
        
                                <!-- Right Table -->
                                <div class="right-form">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr class="monthly-breakdown">
                                                <th colspan="4">Monthly Payment Breakdown</th>
                                            </tr>
                                            <tr>
                                                <th class="breakdown-header">Component</th>
                                                <th class="breakdown-header">Value</th>
                                                <th class="breakdown-header">Calculation</th>
                                                <th class="breakdown-header">Annual</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="lbl-right">Principle</td>
                                                <td><input class="breakdown-input" type="number" id="principleInput" class="form-control"></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
                                            <tr>
                                                <td class="lbl-right">Interest</td>
                                                <td><input class="breakdown-input" type="number" id="interestInput" class="form-control"></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
                                            <tr>
                                                <td class="lbl-right">Taxes</td>
                                                <td><input class="breakdown-input" type="number" id="taxesMonthly" class="form-control" readonly style="background-color: #f9f9f9;"></td>
                                                <td><input class="breakdown-input" type="number" id="taxesCalc" class="form-control" readonly style="background-color: #f9f9f9;"></td>
                                                <td><input class="breakdown-input" type="number" id="taxesAnnual" class="form-control"></td>
                                            </tr>
                                            <tr>
                                                <td class="lbl-right">Insurance</td>
                                                <td><input class="breakdown-input" type="number" id="insuranceInput" class="form-control"></td>
                                                <td><input class="breakdown-input" type="number" id="insuranceCalc" class="form-control" readonly style="background-color: #f9f9f9;"></td>
                                                <td></td>
                                            </tr>
                                            <tr>
                                                <td class="lbl-right">Escrow</td>
                                                <td><input class="breakdown-input" type="number" id="escrowInput" class="form-control"></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
                                            <tr>
                                                <td class="lbl-right">Escrow Balance</td>
                                                <td><input class="breakdown-input" type="number" id="escrowBalanceInput" class="form-control"></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
        
                            <!-- Address Section -->
                            <div class="address-container">
                                <div class="form-group">
                                    <label for="address">Address</label>
                                    <input type="text" class="form-control" id="address" name="address" autocomplete="off" placeholder="Start typing an address..." required>
                                </div>
                                <div class="form-group">
                                    <label for="locality">City</label>
                                    <input type="text" class="form-control" id="locality" name="locality" required>
                                </div>
                                <div class="form-group">
                                    <label for="state">State</label>
                                    <select class="form-control" id="state" name="state" required>
                                        <option value="">Select a state</option>
                                        <% if (typeof error === 'undefined') { %>
                                            <% states.forEach(function(state) { %>
                                                <option value="<%= state.code %>"><%= state.name %></option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="postalCode">Postal Code</label>
                                    <input type="text" class="form-control" id="postalCode" name="postalCode" required>
                                </div>
                            </div>
        
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary btn-lg w-100">Calculate</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        
            <!-- The IFW Form pane goes here -->
            <div class="tab-pane fade" id="ifw_form">
                <form method="POST">
                    <!-- Top Section Card -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="row">
                                <!-- Left Column -->
                                <div class="col-md-6">
                                    <!-- First Group -->
                                    <div class="gap-section">
                                        <div class="form-group">
                                            <label>Last Payment Date</label>
                                            <input type="date" class="form-control" name="lastPaymentDate">
                                        </div>
                                        <div class="form-group">
                                            <label>Balance on 1st</label>
                                            <input type="text" class="form-control currency-input" name="balanceOn1st">
                                        </div>
                                        <div class="form-group">
                                            <label>Interest Due (+6 day cushion)</label>
                                            <input type="text" class="form-control currency-input" name="interestDue1st">
                                        </div>
                                        <div class="form-group">
                                            <label>Total 1st Payoff (+6 day cushion)</label>
                                            <input type="text" class="form-control currency-input" name="total1stPayoff">
                                        </div>
                                    </div>
            
                                    <!-- Second Group (after gap) -->
                                    <div class="gap-section">
                                        <div class="form-group">
                                            <label>Balance on 2nd</label>
                                            <input type="text" class="form-control currency-input" name="balanceOn2nd">
                                        </div>
                                        <div class="form-group">
                                            <label>Interest Due (+6 day cushion)</label>
                                            <input type="text" class="form-control currency-input" name="interestDue2nd">
                                        </div>
                                        <div class="form-group">
                                            <label>Total 2nd Payoff</label>
                                            <input type="text" class="form-control currency-input" name="total2ndPayoff">
                                        </div>
                                        <div class="form-group">
                                            <label>Other Debts to Payoff at Closing</label>
                                            <input type="text" class="form-control currency-input" name="otherDebts">
                                        </div>
                                        <div class="form-group">
                                            <label>Total Payoffs</label>
                                            <input type="text" class="form-control currency-input" name="totalPayoffs">
                                        </div>
                                    </div>
                                </div>
            
                                <!-- Right Column -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Funding Date</label>
                                        <input type="date" class="form-control" name="fundingDate">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Lower Section -->
                <div class="row g-3 g-md-4">
                    <!-- Left Column Card -->
                    <div class="col-12 col-md-6">
                        <div class="card mb-3 mb-md-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Property Value: </h5>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label>Loan Purpose</label>
                                    <input type="text" class="form-control" name="loanPurpose">
                                </div>
                                <div class="form-group">
                                    <label>Program</label>
                                    <input type="text" class="form-control" name="program">
                                </div>
                                <div class="form-group">
                                    <label>FICO</label>
                                    <input type="number" class="form-control" name="fico" min="300" max="850">
                                </div>
                                <div class="form-group">
                                    <label>LTV</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control percent-input" name="ltv" step="0.01">
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Monthly Mortgage Ins.</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control percent-input" name="monthlyMortgageIns" step="0.01">
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card mb-3 mb-md-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Origination Charges: </h5>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label>Admin fee</label>
                                    <input type="text" class="form-control currency-input" name="adminFee">
                                </div>
                                <div class="form-group">
                                    <label>Discount Points</label>
                                    <input type="text" class="form-control currency-input" name="discountPoints">
                                </div>
                                <div class="form-group">
                                    <label>Underwriting fee</label>
                                    <input type="text" class="form-control currency-input" name="underwritingFee">
                                </div>
                                <div class="form-group">
                                    <label>Lender credit</label>
                                    <input type="number" class="form-control currency-input" name="lenderCredit">
                                </div>
                            </div>
                            
                        </div>
                        <div class="card mb-3 mb-md-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Services Borrower Cannot Shop: </h5>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label>Appraisal Fee (POC)</label>
                                    <input type="text" class="form-control currency-input" name="appraisalFee">
                                </div>
                                <div class="form-group">
                                    <label>Credit Report Fee</label>
                                    <input type="text" class="form-control currency-input" name="creditReportFee">
                                </div>
                                <div class="form-group">
                                    <label>Flood Cert</label>
                                    <input type="text" class="form-control currency-input" name="floodCert">
                                </div>
                                <div class="form-group">
                                    <label>Third Processing Fee</label>
                                    <input type="number" class="form-control currency-input" name="thirdProcessingFee">
                                </div>
                                <!-- Add two rows of space -->
                                <!-- <div class="form-group">
                                    <label class="invisible">Spacer</label>
                                    <input type="text" class="form-control invisible" disabled>
                                </div> -->
                                <div class="form-group">
                                    <label class="invisible">Spacer</label>
                                    <input type="text" class="form-control invisible" disabled>
                                </div>
                                <div class="form-group">
                                    <label class="invisible">Spacer</label>
                                    <input type="text" class="form-control invisible" disabled>
                                </div>
                            </div>
                        </div>
                        <div class="card mb-3 mb-md-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Services Borrower Cannot Shop For: </h5>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label>Title - Closing Coordination Fee </label>
                                    <input type="text" class="form-control currency-input" name="titleClosingCoordinationFee">
                                </div>
                                <div class="form-group">
                                    <label>Title - Closing Fee </label>
                                    <input type="text" class="form-control currency-input" name="titleClosingFee">
                                </div>
                                <div class="form-group">
                                    <label>Title - e Recording Fee </label>
                                    <input type="text" class="form-control currency-input" name="titleeRecordingFee">
                                </div>
                                <div class="form-group">
                                    <label>Title - Lenders Coverage Premium</label>
                                    <input type="number" class="form-control currency-input" name="titleLendersCoveragePremium">
                                </div>
                                <div class="form-group">
                                    <label>Title - Notary Fee</label>
                                    <input type="number" class="form-control currency-input" name="titleNotaryFee">
                                </div>
                                <div class="form-group">
                                    <label>Title - Settlement Fee</label>
                                    <input type="number" class="form-control currency-input" name="titleSettlementFee">
                                </div>
                                <div class="form-group">
                                    <label>Title - Title Search Fee</label>
                                    <input type="number" class="form-control currency-input" name="titleSearchFee">
                                </div>
                            </div>
                        </div>
                        <div class="card mb-3 mb-md-4">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Totals (Payoff, Costs, Escrow)</h5>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label>Payoff </label>
                                    <input type="text" class="form-control currency-input" name="payoff">
                                </div>
                                <div class="form-group">
                                    <label>Estimated Prepaid & Escrow </label>
                                    <input type="text" class="form-control currency-input" name="estimatedPrepaidAndEscrow">
                                </div>
                                <div class="form-group">
                                    <label>Estimate Closing Cost </label>
                                    <input type="text" class="form-control currency-input" name="estimatedClosingCost">
                                </div>
                                <div class="form-group">
                                    <label>Other Debts </label>
                                    <input type="number" class="form-control currency-input" name="otherDebts">
                                </div>
                                <div class="form-group">
                                    <label>FHA MIP </label>
                                    <input type="number" class="form-control currency-input" name="fhaMIP">
                                </div>
                                <div class="form-group">
                                    <label>Other </label>
                                    <input type="number" class="form-control currency-input" name="other">
                                </div>
                                <div class="form-group">
                                    <label>Total Due from Borrower at Closing </label>
                                    <input type="number" class="form-control currency-input" name="totalDueFromBorrower">
                                </div>
                                <div class="form-group">
                                    <label>Lender Credit  </label>
                                    <input type="number" class="form-control currency-input" name="lenderCredit">
                                </div>
                                <div class="form-group">
                                    <label>Borrower Prepaid Fees  </label>
                                    <input type="number" class="form-control currency-input" name="borrowerPrepaidFees">
                                </div>
                                <!-- Add this to create a row of empty space -->
                                <div class="form-group">
                                    <label class="invisible">Spacer</label>
                                    <input type="text" class="form-control invisible" disabled>
                                </div>
                                <div class="form-group">
                                    <label>FHA/MIP</label>
                                    <input type="text" class="form-control currency-input" name="fhaMIP2">
                                </div>
                                <div class="form-group">
                                    <label>Loan Amount</label>
                                    <input type="text" class="form-control currency-input" name="loanAmount">
                                </div>
                                <div class="form-group">
                                    <label> Paid Already by or on Behalf of Borrower</label>
                                    <input type="text" class="form-control currency-input" name="paidAlready">
                                </div>
                             
                                <div class="form-group" style="background-color: lightslategray;">
                                    <label style="font-weight: bold;">Total Estimated Funds To/From You:</label>
                                    <input type="text" class="form-control currency-input" name="totalEstimatedFunds">
                                </div>
                            </div>
                        </div>
                        <!-- <div class="card mb-3 mb-md-4">
                                
                            <div class="card-body">
                                <div class="form-group">
                                    <label>FHA/MIP</label>
                                    <input type="text" class="form-control currency-input" name="fhaMIP2">
                                </div>
                                <div class="form-group">
                                    <label>Loan Amount</label>
                                    <input type="text" class="form-control currency-input" name="loanAmount">
                                </div>
                                <div class="form-group">
                                    <label> Paid Already by or on Behalf of Borrower</label>
